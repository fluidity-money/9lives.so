[Unit]
Description=9lives Websocket
Requires=ninelives-websocket.socket
After=network-online.target ninelives-websocket.socket
Wants=network-online.target

[Service]
Type=simple
User=ninelives
Group=database-users
EnvironmentFile=/etc/websocket-9lives.so/config
ExecStart=/usr/local/bin/ninelives-websocket
Restart=on-failure
RestartSec=3s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
