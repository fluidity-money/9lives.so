+// Several labelled lines. Unlike referenceLine these never widen the price
+// range; a value outside it is pinned to the nearest edge with an arrow.
+function drawReferenceLines(ctx, layout, palette, refs) {
+  const { w, h, pad, toY } = layout;
+  const top = pad.top;
+  const bottom = h - pad.bottom;
+  const right = w - pad.right;
+  const lineH = 16;
+  ctx.font = "500 11px system-ui, sans-serif";
+  ctx.textAlign = "left";
+  ctx.textBaseline = "middle";
+  const items = refs
+    .map((ref) => {
+      const y = toY(ref.value);
+      const edge = y < top ? -1 : y > bottom ? 1 : 0;
+      const text = (edge < 0 ? "\u25B2 " : edge > 0 ? "\u25BC " : "") + (ref.label ?? "");
+      return { ref, y, edge, text, ly: edge < 0 ? top + lineH / 2 : edge > 0 ? bottom - lineH / 2 : y };
+    })
+    .sort((a, b) => a.ly - b.ly);
+  // Every line first, so no line is drawn across another's label.
+  for (const item of items) {
+    const color = item.ref.color ?? palette.refLabel;
+    if (!item.edge) {
+      ctx.save();
+      ctx.globalAlpha *= 0.7;
+      ctx.strokeStyle = color;
+      ctx.lineWidth = 1;
+      ctx.setLineDash([4, 4]);
+      ctx.beginPath();
+      ctx.moveTo(pad.left, item.y);
+      ctx.lineTo(right, item.y);
+      ctx.stroke();
+      ctx.restore();
+    }
+  }
+  const placed = [];
+  for (const item of items) {
+    const color = item.ref.color ?? palette.refLabel;
+    if (!item.text) continue;
+    const tw = ctx.measureText(item.text).width + 10;
+    // Labels start at the left, away from the live dot and badge on the
+    // right, and step right (then to the next row) to avoid each other.
+    let x = pad.left + 6;
+    let ly = item.ly;
+    for (let tries = 0; tries < 50; tries++) {
+      const hit = placed.find((r) => Math.abs(r.y - ly) < lineH && x < r.x + r.w + 6 && x + tw > r.x - 6);
+      if (!hit) break;
+      x = hit.x + hit.w + 6;
+      if (x + tw > right - 6) {
+        x = pad.left + 6;
+        ly += item.edge > 0 ? -lineH : lineH;
+      }
+    }
+    placed.push({ x, y: ly, w: tw });
+    ctx.fillStyle = palette.tooltipBg;
+    ctx.beginPath();
+    ctx.roundRect(x, ly - lineH / 2 + 1, tw, lineH - 2, 4);
+    ctx.fill();
+    ctx.fillStyle = color;
+    ctx.fillText(item.text, x + 5, ly + 0.5);
+  }
+  ctx.textBaseline = "alphabetic";
+}
