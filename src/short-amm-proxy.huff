// short-amm-proxy: Version of bobcat-sdk's sel-beacon-proxy that's intended
// only for the short-term AMM markets. Sets the fields for setup during the
// construction instead of needing to call the function that's
// responsible for making everything go live. Does so by setting the raw
// slots. Constructor and the constants here generated by Opus 4.8.

#define constant BEACON = 0x1111111111111111111111111111111111111111

#define constant SEL_IMPL = 0x6b8e8d96

#define constant OUTCOME_A     = 0x3e95898c9a0b6cb0   // bytes8 id
#define constant ORACLE        = 0x2000000000000000000000000000000000000002
#define constant TIME_START    = 0x13   // uint
#define constant TIME_ENDING   = 0x24   // uint
#define constant FEE_RECIPIENT = 0x2000000000000000000000000000000000000005
#define constant FEE_CREATOR   = 0x26   // uint
#define constant FEE_LP        = 0x27   // uint
#define constant FEE_MINTER    = 0x28   // uint
#define constant FEE_REFERRER  = 0x29   // uint
#define constant SEED_LIQ      = 0x2a   // uint
#define constant OUTCOME_B     = 0x4e95898c9a0b6cb0   // bytes8 id

#define macro MAIN() = takes(0) returns(0) {
	0x24 0x04 0x20 calldatasize dup3 dup3 calldataload
	0x00 0x00 calldatasize dup7
	[SEL_IMPL] 0x00 mstore
	dup6 0x00 dup10 calldatacopy
	dup1 dup11 dup1 0x1c [BEACON] gas staticcall
	iszero REVERT jumpi
	dup10 mload
	calldatasize dup11 dup13 calldatacopy
	gas delegatecall
	returndatasize 0x0 0x0 returndatacopy
	0x00 returndatasize swap2 iszero REVERT jumpi return
	REVERT:
		revert
}

#define macro CONSTRUCTOR() = takes(0) returns(0) {
	// No calldata / no codecopy tail. All fields come from the constants above.

	// --- Slot 0: created(bool@0) | factory_addr(address@1) ---
	// value = (caller << 8) | 1
	caller 0x08 shl 0x01 or
	0x00 sstore

	// --- Slot 1: fee_recipient(@0) | time_start(@160) | time_ending(@224) ---
	[TIME_ENDING] 0xe0 shl			// time_ending << 224
	[TIME_START]  0xa0 shl or		// | time_start << 160
	[FEE_RECIPIENT] or				// | fee_recipient
	0x01 sstore

	// --- Slot 2: oracle ---
	[ORACLE] 0x02 sstore

	// --- Slot 4: outcome_list length = 2 ---
	0x02 0x04 sstore

	// --- Slot 5 (winner/should_buffer_time/__unused_1) left zero ---

	// --- Slots 6..9: fees ---
	[FEE_CREATOR]  0x06 sstore
	[FEE_MINTER]   0x07 sstore
	[FEE_LP]       0x08 sstore
	[FEE_REFERRER] 0x09 sstore

	// --- Slot 16: amm_liquidity = seed_liq ---
	[SEED_LIQ] 0x10 sstore

	// ============ Outcome data ============
	// outcome_a / outcome_b are bytes8 values held LEFT-aligned (top 8 bytes)
	// in a 32-byte word, so we shift each up by 192 bits (0xc0).
	// Stash B @ mem 0x00 and A @ mem 0x20 for reuse below.
	[OUTCOME_B] 0xc0 shl  0x00 mstore	// mem[0x00] = B (left-aligned)
	[OUTCOME_A] 0xc0 shl  0x20 mstore	// mem[0x20] = A (left-aligned)

	// --- outcome_list element slot: keccak256(4) ---
	// pack: A | (B >> 64)
	0x20 mload						// A
	0x00 mload 0x40 shr or			// A | (B >> 64)
	0x04 0x180 mstore
	0x20 0x180 sha3					// [slot, packedvalue]
	sstore

	// mapping-key scratch: key @ 0x180, map-slot @ 0x1a0, sha3 0x40.

	// ---- outcome_a mappings (key = A @ mem 0x20) ----
	0x20 mload 0x180 mstore

	0x18 0x1a0 mstore						// amm_outcome_exists[A] = 1
	0x40 0x180 sha3  0x01 swap1 sstore

	0x12 0x1a0 mstore						// amm_shares[A] = seed_liq
	0x40 0x180 sha3  [SEED_LIQ] swap1 sstore

	0x13 0x1a0 mstore						// amm_total_shares[A] = seed_liq
	0x40 0x180 sha3  [SEED_LIQ] swap1 sstore

	// ---- outcome_b mappings (key = B @ mem 0x00) ----
	0x00 mload 0x180 mstore

	0x18 0x1a0 mstore						// amm_outcome_exists[B] = 1
	0x40 0x180 sha3  0x01 swap1 sstore

	0x12 0x1a0 mstore						// amm_shares[B] = seed_liq
	0x40 0x180 sha3  [SEED_LIQ] swap1 sstore

	0x13 0x1a0 mstore						// amm_total_shares[B] = seed_liq
	0x40 0x180 sha3  [SEED_LIQ] swap1 sstore
}
