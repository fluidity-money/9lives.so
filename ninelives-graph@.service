[Unit]
Description=9lives graph for %i
Requires=ninelives-graph@%i.socket
After=network-online.target ninelives-graph@%i.socket
Wants=network-online.target

[Service]
Type=simple
User=ninelives
Group=database-users
EnvironmentFile=/etc/fluidity-apps/%i.conf
ExecStart=/usr/local/bin/ninelives-graph
Restart=on-failure
RestartSec=3s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
